{
  "version": 3,
  "configurePresets": [
    {
      "hidden": true,
      "name": "Qt",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{QTDIR}"
      },
      "vendor": {
        "qt-project.org/Qt": {
          "checksum": "wVa86FgEkvdCTVp1/nxvrkaemJc="
        }
      }
    },

    {
      "name": "macos-clang-openmp",
      "displayName": "macOS (Clang + Homebrew OpenMP)",
      "description": "Build with Apple Clang and Homebrew libomp. Qt prefix comes from $env{QTDIR}.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "inherits": ["Qt"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",

        "CMAKE_C_COMPILER": "/usr/bin/clang",
        "CMAKE_CXX_COMPILER": "/usr/bin/clang++",

        "OpenMP_C_FLAGS": "-Xpreprocessor -fopenmp -I/opt/homebrew/opt/libomp/include",
        "OpenMP_CXX_FLAGS": "-Xpreprocessor -fopenmp -I/opt/homebrew/opt/libomp/include",
        "OpenMP_C_LIB_NAMES": "omp",
        "OpenMP_CXX_LIB_NAMES": "omp",
        "OpenMP_omp_LIBRARY": "/opt/homebrew/opt/libomp/lib/libomp.dylib",

        "CMAKE_EXE_LINKER_FLAGS": "-L/opt/homebrew/opt/libomp/lib",
        "CMAKE_SHARED_LINKER_FLAGS": "-L/opt/homebrew/opt/libomp/lib",

        "CMAKE_PREFIX_PATH": "/opt/homebrew/opt/libomp;$env{QTDIR}"
      },
      "environment": {
        "PATH": "/opt/homebrew/opt/libomp/bin:$penv{PATH}"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },

    {
      "name": "macos-clang-openmp-intel",
      "displayName": "macOS Intel (Clang + Homebrew OpenMP)",
      "description": "Intel macOS paths for Homebrew libomp with Apple Clang.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "inherits": ["Qt"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",

        "CMAKE_C_COMPILER": "/usr/bin/clang",
        "CMAKE_CXX_COMPILER": "/usr/bin/clang++",

        "OpenMP_C_FLAGS": "-Xpreprocessor -fopenmp -I/usr/local/opt/libomp/include",
        "OpenMP_CXX_FLAGS": "-Xpreprocessor -fopenmp -I/usr/local/opt/libomp/include",
        "OpenMP_C_LIB_NAMES": "omp",
        "OpenMP_CXX_LIB_NAMES": "omp",
        "OpenMP_omp_LIBRARY": "/usr/local/opt/libomp/lib/libomp.dylib",

        "CMAKE_EXE_LINKER_FLAGS": "-L/usr/local/opt/libomp/lib",
        "CMAKE_SHARED_LINKER_FLAGS": "-L/usr/local/opt/libomp/lib",

        "CMAKE_PREFIX_PATH": "/usr/local/opt/libomp;$env{QTDIR}"
      },
      "environment": {
        "PATH": "/usr/local/opt/libomp/bin:$penv{PATH}"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },

    {
      "name": "macos-llvm-openmp",
      "displayName": "macOS (Homebrew LLVM clang + OpenMP)",
      "description": "Build with Homebrew LLVM clang and OpenMP (libomp). Qt prefix comes from $env{QTDIR}.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "inherits": ["Qt"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "/opt/homebrew/opt/llvm/bin/clang",
        "CMAKE_CXX_COMPILER": "/opt/homebrew/opt/llvm/bin/clang++",

        "OpenMP_C_FLAGS": "-Xpreprocessor -fopenmp -I/opt/homebrew/opt/libomp/include",
        "OpenMP_CXX_FLAGS": "-Xpreprocessor -fopenmp -I/opt/homebrew/opt/libomp/include",
        "OpenMP_C_LIB_NAMES": "omp",
        "OpenMP_CXX_LIB_NAMES": "omp",
        "OpenMP_omp_LIBRARY": "/opt/homebrew/opt/libomp/lib/libomp.dylib",

        "CMAKE_EXE_LINKER_FLAGS": "-L/opt/homebrew/opt/libomp/lib",
        "CMAKE_SHARED_LINKER_FLAGS": "-L/opt/homebrew/opt/libomp/lib",

        "CMAKE_PREFIX_PATH": "/opt/homebrew/opt/libomp;$env{QTDIR}"
      },
      "environment": {
        "PATH": "/opt/homebrew/opt/llvm/bin:$penv{PATH}"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },

    {
      "name": "macos-llvm-openmp-intel",
      "displayName": "macOS Intel (Homebrew LLVM clang + OpenMP)",
      "description": "Intel mac alternative paths for Homebrew LLVM/libomp.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "inherits": ["Qt"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "/usr/local/opt/llvm/bin/clang",
        "CMAKE_CXX_COMPILER": "/usr/local/opt/llvm/bin/clang++",

        "OpenMP_C_FLAGS": "-Xpreprocessor -fopenmp -I/usr/local/opt/libomp/include",
        "OpenMP_CXX_FLAGS": "-Xpreprocessor -fopenmp -I/usr/local/opt/libomp/include",
        "OpenMP_C_LIB_NAMES": "omp",
        "OpenMP_CXX_LIB_NAMES": "omp",
        "OpenMP_omp_LIBRARY": "/usr/local/opt/libomp/lib/libomp.dylib",

        "CMAKE_EXE_LINKER_FLAGS": "-L/usr/local/opt/libomp/lib",
        "CMAKE_SHARED_LINKER_FLAGS": "-L/usr/local/opt/libomp/lib",

        "CMAKE_PREFIX_PATH": "/usr/local/opt/libomp;$env{QTDIR}"
      },
      "environment": {
        "PATH": "/usr/local/opt/llvm/bin:$penv{PATH}"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    }
  ],

  "vendor": {
    "qt-project.org/Presets": {
      "checksum": "67SmY24ZeVbebyKD0fGfIzb/bGI="
    }
  }
}